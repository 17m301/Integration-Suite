                <ifl:property>
                    <key>wrapContent</key>
                    <value>${body}
Hello ${property.name}

current date: ${property.date}

current count: ${property.count}</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.6</value>
                </ifl:property>
                <ifl:property>
                    <key>activityType</key>
