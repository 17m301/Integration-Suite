            <bpmn2:messageEventDefinition/>
        </bpmn2:endEvent>
        <bpmn2:callActivity id="CallActivity_5" name="Content Modifier">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;?xml version="1.0" encoding="UTF-8"?&gt;
