            &lt;FirstName&gt;Rachel&lt;/FirstName&gt;
            &lt;LastName&gt;Walker&lt;/LastName&gt;
            &lt;Gender&gt;Female&lt;/Gender&gt;
            &lt;DOB&gt;2001-11-03&lt;/DOB&gt;
        &lt;/PersonalDetails&gt;

        &lt;Contact&gt;
            &lt;Email&gt;RACHEL.WALKER@MAIL.COM&lt;/Email&gt;
            &lt;Phone&gt;
                &lt;CountryCode&gt;+1&lt;/CountryCode&gt;
