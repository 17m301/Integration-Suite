        <bpmn2:callActivity id="CallActivity_5" name="Content Modifier 1">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>constant</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;Company&gt;

	&lt;Employee&gt;
		&lt;firstName&gt;John&lt;/firstName&gt;
		&lt;lastName&gt;Smith&lt;/lastName&gt;
		&lt;Age&gt;30&lt;/Age&gt;
		&lt;Salary&gt;1200000&lt;/Salary&gt;
		&lt;PhoneNumber&gt;09999188288&lt;/PhoneNumber&gt;
		&lt;hireDate&gt;19/07/1998&lt;/hireDate&gt;
		&lt;Gender&gt;Male&lt;/Gender&gt;
		&lt;Country&gt;India&lt;/Country&gt;
		&lt;Status&gt;A&lt;/Status&gt;
	&lt;/Employee&gt;
	&lt;Employee&gt;
		&lt;firstName&gt;Steve&lt;/firstName&gt;
		&lt;lastName&gt;Doe&lt;/lastName&gt;
		&lt;Age&gt;25&lt;/Age&gt;
		&lt;Salary&gt;1500000&lt;/Salary&gt;
		&lt;PhoneNumber&gt;09999188288&lt;/PhoneNumber&gt;
		&lt;hireDate&gt;19/07/2000&lt;/hireDate&gt;
		&lt;Gender&gt;Male&lt;/Gender&gt;
		&lt;Country&gt;US&lt;/Country&gt;
		&lt;Status&gt;T&lt;/Status&gt;
	&lt;/Employee&gt;
	&lt;Employee&gt;
		&lt;firstName&gt;Ram&lt;/firstName&gt;
		&lt;lastName&gt;Kirk&lt;/lastName&gt;
		&lt;Age&gt;35&lt;/Age&gt;
		&lt;Salary&gt;3500000&lt;/Salary&gt;
		&lt;PhoneNumber&gt;09999188288&lt;/PhoneNumber&gt;
		&lt;hireDate&gt;19/07/2004&lt;/hireDate&gt;
		&lt;Gender&gt;Male&lt;/Gender&gt;
		&lt;Country&gt;Sri Lanka&lt;/Country&gt;
		&lt;Status&gt;A&lt;/Status&gt;
	&lt;/Employee&gt;

&lt;/Company&gt;</value>
                </ifl:property>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.6</value>
                </ifl:property>
                <ifl:property>
